const uint8_t bayer4[4][4] = {{0, 8, 2, 10}, {12, 4, 14, 6}, {3, 11, 1, 9}, {15, 7, 13, 5}};
const char* names[] = {"EARTH", "MARS", "MOON", "SATURN", "JUPITER"};
const int NUM = 5;
int planet = 0;
unsigned long lastSwitch = 0;
float rot = 0;
struct Rock { float x, y, vx, vy; int s; };
Rock rocks[4];
void respawn(Rock &r) {
  r.x = 130 + random(0, 80);
  r.y = random(4, 60);
  r.vx = -random(20, 50) / 10.0;
  r.vy = random(-10, 11) / 10.0;
  r.s = random(1, 4);
}
void drawRock(int cx, int cy, int s) {
  for (int dy = -s; dy <= s; dy++) {
    for (int dx = -s; dx <= s; dx++) {
      float d2 = dx * dx + dy * dy;
      if (d2 > (s + 0.5) * (s + 0.5)) continue;
      int x = cx + dx, y = cy + dy;
      if (x < 0 || x > 127 || y < 0 || y > 63) continue;
      u8g2.setDrawColor(d2 >= (s - 0.5) * (s - 0.5) ? 1 : 0);  
      u8g2.drawPixel(x, y);
    }
  }
  u8g2.setDrawColor(1);
}
void px(int x, int y) {
  if (x >= 0 && x < 128 && y >= 0 && y < 64) u8g2.drawPixel(x, y);
}
const float DEG = 0.0174533;
const float jupBands[][2] = {
  { 62, 1}, { 50, 2}, { 40, 1}, { 31, 2}, { 24, 1},   
  { 17, 3},                                            
  {  7, 0},                                            
  { -7, 3},                                            
  {-20, 0},                                            
  {-27, 3},                                            
  {-35, 1}, {-45, 2}, {-58, 1}, {-68, 2}, {-91, 1}    
};
const int NUM_JBANDS = sizeof(jupBands) / sizeof(jupBands[0]);
float wrapPi(float a) {
  while (a > PI) a -= 2 * PI;
  while (a < -PI) a += 2 * PI;
  return a;
}
bool texel(int type, int sx, int sy, float lat, float lon) {
  bool checker = ((sx + sy) & 1) == 0;
  if (type == 0) {                       
    int col = (int)((lon / (2 * PI) + 0.5) * 128);
    col = ((col % 128) + 128) % 128;
    int row = (int)((0.5 - lat / PI) * 64);
    if (row < 0) row = 0;
    if (row > 63) row = 63;
    uint8_t b = pgm_read_byte(&worldMap[row * 16 + col / 8]);
    return b & (0x80 >> (col % 8));                     
  }
  if (type == 1) {                       
    float L = wrapPi(lon);
    if (L > PI / 2) L = PI - L;          
    else if (L < -PI / 2) L = -PI - L;
    int u = (int)(88.0 + cos(lat) * sin(L) * 87.0 + 0.5);
    int v = (int)(88.0 - sin(lat) * 87.0 + 0.5);
    int n = 0;
    for (int dy = -1; dy <= 1; dy++) {   
      for (int dx = -1; dx <= 1; dx++) {
        int xx = u + dx, yy = v + dy;
        if (xx < 0 || xx > 175 || yy < 0 || yy > 175) continue;
        if (pgm_read_byte(&marsSrc[yy * 22 + (xx >> 3)]) & (0x80 >> (xx & 7))) n++;
      }
    }
    return n >= 2;
  }
  if (type == 2) {                       
    float L = wrapPi(lon);
    if (L > PI / 2) L = PI - L;          
    else if (L < -PI / 2) L = -PI - L;
    int u = (int)(88.0 + cos(lat) * sin(L) * 84.0 + 0.5);
    int v = (int)(88.0 - sin(lat) * 84.0 + 0.5);
    int n = 0;
    for (int dy = -1; dy <= 1; dy++) {   
      for (int dx = -1; dx <= 1; dx++) {
        int xx = u + dx, yy = v + dy;
        if (xx < 0 || xx > 175 || yy < 0 || yy > 175) continue;
        if (pgm_read_byte(&moonSrc[yy * 22 + (xx >> 3)]) & (0x80 >> (xx & 7))) n++;
      }
    }
    float g = (n / 9.0 - 0.22) / 0.56;
    return g > (bayer4[sy & 3][sx & 3] + 0.5) / 16.0;
  }
  if (type == 4) {                       
    float L = wrapPi(lon);
    {
      float dl = wrapPi(L - 1.0) * cos(lat) / 0.30;
      float dt = (lat + 22.0 * DEG) / 0.15;
      float e = dl * dl + dt * dt;
      if (e < 0.35) return true;
      if (e < 1.0) return false;
      if (e < 1.8) return true;
    }
    float d = lat / DEG + 2.2 * sin(L * 4.0 + lat * 2.0) + 1.2 * sin(L * 9.0);
    int level = (int)jupBands[NUM_JBANDS - 1][1];
    for (int i = 0; i < NUM_JBANDS; i++) {
      if (d > jupBands[i][0]) { level = (int)jupBands[i][1]; break; }
    }
    return level >= 2;                               
  }
  if (fabs(lat) > 1.2) return false;
  float v = sin(lat * 9.0 + 0.3 * sin(lon * 2.0));
  return v > 0.1;
}
void drawSphere(int cx, int cy, int r, int type, float spin) {
  if (type != 2) u8g2.drawCircle(cx, cy, r + 1);
  for (int py = -r; py <= r; py++) {
    for (int pxl = -r; pxl <= r; pxl++) {
      float x = pxl / (float)r;
      float y = py / (float)r;
      float d2 = x * x + y * y;
      if (d2 > 1.0) continue;
      float z = sqrt(1.0 - d2);
      float lat = asin(-y);
      float lon = atan2(x, z) - spin;
      if (texel(type, cx + pxl, cy + py, lat, lon)) u8g2.drawPixel(cx + pxl, cy + py);
    }
  }
}
void drawRing(int cx, int cy, int rx, int ry, int planetR, bool front, float spin) {
  const float tilt = -0.35;
  float ct = cos(tilt), st = sin(tilt);
  for (float a = 0; a < 2 * PI; a += 0.02) {
    bool isFront = sin(a) > 0;
    if (isFront != front) continue;
    if (fmod(a + spin, 2 * PI / 7) > 0.55) continue;   
    float ex = rx * cos(a), ey = ry * sin(a);
    int x = cx + ex * ct - ey * st;
    int y = cy + ex * st + ey * ct;
    if (!front) {
      int dx = x - cx, dy = y - cy;
      if (dx * dx + dy * dy < planetR * planetR) continue;
    }
    px(x, y);
  }
}
void setup() {
  u8g2.begin();
  myServo.setPeriodHertz(50);              
  myServo.attach(SERVO_PIN, 500, 2400);    
  for (int i = 0; i < 4; i++) respawn(rocks[i]);
}
void loop() {
  if (millis() - lastSwitch > 6000) {
    planet = (planet + 1) % NUM;
    lastSwitch = millis();
    myServo.write(planet * 45);            
  }
  u8g2.clearBuffer();
  if (planet == 3) {                       
    drawSphere(64, 32, 17, 3, rot);
    drawRing(64, 32, 30, 8, 17, false, rot);
    drawRing(64, 32, 30, 8, 17, true, rot);
    drawRing(64, 32, 25, 6, 17, false, rot * 2);
    drawRing(64, 32, 25, 6, 17, true, rot * 2);
  } else {
    drawSphere(64, 32, 30, planet, rot);
  }
  for (int i = 0; i < 4; i++) {
    Rock &r = rocks[i];
    r.x += r.vx;
    r.y += r.vy;
    if (r.x < -10 || r.y < -10 || r.y > 74) respawn(r);
    int ix = (int)r.x, iy = (int)r.y;
    for (int k = 2; k <= 8; k += 2) px(ix - r.vx * k, iy - r.vy * k);   
    drawRock(ix, iy, r.s);
  }
  u8g2.setFont(u8g2_font_5x7_tr);
  u8g2.drawStr(0, 7, names[planet]);
  u8g2.sendBuffer();
  rot += 0.08;
  if (rot > 2 * PI) rot -= 2 * PI;
}